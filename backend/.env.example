APP_ENV=development
APP_NAME=Valaiyagam Shopping API
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Same PostgreSQL database as classic-way-admin (shared tables — do not create a second schema).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=valaiyagam
POSTGRES_USER=valaiyagam
POSTGRES_PASSWORD=replace-with-a-strong-password
# DATABASE_URL=postgresql+psycopg://valaiyagam:replace-with-a-strong-password@localhost:5432/valaiyagam

PAYMENT_PROVIDER=cod
PAYMENT_SECRET=
STORAGE_PROVIDER=local

# Serve product/category images from the same uploads directory (or Docker volume) as admin.
# Default path is ./uploads relative to the process working directory.
